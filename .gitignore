__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# `python -m build` output (012 §12.2's Suite W builds into tmp dirs, not
# here, but a manual `python -m build` from the repo root drops these).
/build/
/dist/

# Puya compiled output (recompiled by tests/bench harnesses on demand)
_build/
_build_mpt/
_build_composer/
*.puya.map
.secrets/
**/.secrets/

# Cached real beacon-API responses (e.g. full BeaconState dumps, ~150-300MB
# each) so re-running tests/state_anchor/test_live_historical.py during
# development doesn't re-download every time. Never real chain state a
# reviewer needs committed -- it's just an HTTP response cache, keyed by slot.
tests/state_anchor/.cache/

# Vercel CLI project link (environment-specific, not portable across machines
# or accounts -- re-created by `vercel link` from repo root).
.vercel

# M10: private/local deployment manifests (design doc §16) -- a manifest for
# a public deployment (localnet used by this repo's own live tests,
# testnet, mainnet) is committed under deploy/manifests/ deliberately (§9.5:
# it is the durable record of what was deployed); anything suffixed
# `.local.json` is a throwaway individual devnet run and is not.
deploy/manifests/*.local.json
