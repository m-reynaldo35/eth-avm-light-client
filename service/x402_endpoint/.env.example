# Algorand node the relayer submits transactions through.
# Vercel has no local devnet -- point this at a real testnet/mainnet algod
# (e.g. an Algonode public endpoint, or your own node).
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Deployed Mpt7ReceiptApp application ID (see docs/design/007-receipt-log-proof.md).
M7_APP_ID=

# M4/M8 (docs/design/008-trusted-root-anchor.md, 013's fork-table redesign).
# Optional: leave both unset to run the service with only the RPC-trusted
# /verify-receipt route. Set both to also enable the fully trustless
# /verify-receipt-trustless route and the /keeper/run cron.
M4_APP_ID=
M8_APP_ID=

# M9 (docs/design/009-relayer-client.md §7.1): the DonorIssuer/DonorCallee
# pair EthAvmClient.prove_receipt() uses to donate opcode budget as a
# sibling transaction, replacing the old 8-filler-NoOp convention.
DONOR_ISSUER_ID=
DONOR_CALLEE_ID=

# Relayer wallet that submits the proof transaction group. Funds gas/fees
# and (for T2) box MBR -- keep funded, never commit the real value.
RELAYER_MNEMONIC=

# Address the x402 payment settles to.
PAY_TO_ADDRESS=

# GoPlausible facilitator that verifies/settles the x402 payment.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# CAIP-2 network id. Testnet default shown; swap to the mainnet id to charge
# real USDC.
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# Price per request, in micro-USDC (10000 = $0.01).
PRICE_MICRO_USDC=10000

# /keeper/run (Vercel Cron, see vercel.json's `crons`): a dedicated,
# minimal-privilege signer that ONLY ever calls sync()/anchor() -- never
# the relayer's or governance's own mnemonic. Both cryptographically
# self-verifying, so a compromised keeper key can waste its own ALGO on
# rejected calls but cannot move funds, corrupt the fork table, or touch
# governance.
KEEPER_MNEMONIC=

# Vercel auto-injects this as env var + sends it back as
# `Authorization: Bearer $CRON_SECRET` on real cron-triggered requests --
# set it once in the Vercel project settings ("Cron Job Secret"), never in
# a committed file. /keeper/run fails closed (503) if unset.
CRON_SECRET=
