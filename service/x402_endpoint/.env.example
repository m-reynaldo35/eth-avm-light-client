# Algorand node the relayer submits transactions through.
# Vercel has no local devnet -- point this at a real testnet/mainnet algod
# (e.g. an Algonode public endpoint, or your own node).
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Deployed Mpt7ReceiptApp application ID (see docs/design/007-receipt-log-proof.md).
M7_APP_ID=

# Relayer wallet that submits the proof transaction group. Funds gas/fees
# and (for T2) box MBR -- keep funded, never commit the real value.
RELAYER_MNEMONIC=

# Address the x402 payment settles to.
PAY_TO_ADDRESS=

# GoPlausible facilitator that verifies/settles the x402 payment.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# CAIP-2 network id. Testnet default shown; swap to the mainnet id to charge
# real USDC.
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# Price per request, in micro-USDC (10000 = $0.01).
PRICE_MICRO_USDC=10000
